---
import Layout from "../layouts/Layout.astro";
import socials from "../api/socials.json";
import about from "../api/about.json";
import { SocialIcon } from "react-social-icons";

interface Project {
  name: string;
  url: string;
  launched: string;
  image: {
    url: string;
    width: number;
    height: number;
    alt: string;
  };
  summary: string;
  skills: string[];
}
---

<Layout title={about.name}>
  <div class="max-w-screen-xl mx-auto">
    <header class=""></header>
    <main
      class="fixed top-0 right-0 bottom-0 left-0 flex items-center justify-center"
    >
      <div class="min-h-320 mt-[-4em] text-center">
        <h1 class="text-4xl lg:text-5xl xl:text-5xl text-secondary">
          {about.name}
        </h1>
        <h2 class="pt-2 text-xs lg:text-base text-highlight">
          {about.employment_title}
        </h2>
        <ul class="pt-6">
          {
            socials.map((social) => (
              <li class="inline-block mr-4">
                <a
                  href={social.url}
                  rel="noopener noreferrer nofollow"
                  target="_blank"
                >
                  <SocialIcon
                    bgColor="currentColor"
                    fgColor="transparent"
                    url={social.url}
                  />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </main>
  </div>
  <script>
    import consoleMessage from "../api/consoleMessage.json";
    console.log(consoleMessage);
  </script>
</Layout>

<style>
  @tailwind base;
  @tailwind components;
  @tailwind utilities;
</style>
